<!-- 			<list> -->
<!-- 				<value>/WEB-INF/jdbc.properties</value> -->
<!-- 			</list> -->
<!-- 		</property> -->
<!-- 	</bean> -->
	
    
	<bean id="dataSource" class="org.apache.commons.dbcp.BasicDataSource"
		destroy-method="close">
		<property name="driverClassName" value="${jdbc.driverClassName}" />
		<property name="url" value="${jdbc.url}" />
		<property name="username" value="${jdbc.username}" />
		<property name="password" value="${jdbc.password}" />
		<property name="maxActive" value="500" />
		<property name="maxIdle" value="100" />
	</bean>
	
<!-- 	<bean id="monOraDataSource" class="org.apache.commons.dbcp.BasicDataSource" -->
<!-- 		destroy-method="close"> -->
<!-- 		<property name="driverClassName" value="${jdbc.oracle.driverClassName}" /> -->
<!-- 		<property name="url" value="${jdbc.oracle.url}" /> -->
<!-- 		<property name="username" value="${jdbc.oracle.username}" /> -->
<!-- 		<property name="password" value="${jdbc.oracle.password}" /> -->
<!-- 		<property name="maxActive" value="500" /> -->
<!-- 		<property name="maxIdle" value="100" /> -->
<!-- 	</bean> -->

<!-- 	<bean id="mon820DataSource" class="org.apache.commons.dbcp.BasicDataSource" -->
<!-- 		destroy-method="close"> -->
<!-- 		<property name="driverClassName" value="${jdbc.monarch.driverClassName}" /> -->
<!-- 		<property name="url" value="${jdbc.monarch.url}" /> -->
<!-- 		<property name="username" value="${jdbc.monarch.username}" /> -->
<!-- 		<property name="password" value="${jdbc.monarch.password}" /> -->
<!-- 		<property name="maxActive" value="500" /> -->
<!-- 		<property name="maxIdle" value="100" /> -->
<!-- 	</bean> -->

	<!--트랜젝션메니져 -->
	<bean id="transactionManager"
		class="org.springframework.jdbc.datasource.DataSourceTransactionManager">
		<property name="dataSource" ref="dataSource" />
	</bean>
	<bean id="transactionTemplateRequired"
		class="org.springframework.transaction.support.TransactionTemplate">
		<property name="transactionManager" ref="transactionManager" />
		<property name="propagationBehaviorName" value="PROPAGATION_REQUIRED" />
	</bean>

	<!--JDBC템플릿 -->
	<bean id="jdbcTemplate" class="org.springframework.jdbc.core.JdbcTemplate">
		<constructor-arg ref="dataSource" />
	</bean>

	<bean id="namedJdbcTemplate"
		class="org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate">
		<constructor-arg ref="dataSource" />
	</bean>



	<bean id="nativeJdbcExtractor"
		class="org.springframework.jdbc.support.nativejdbc.CommonsDbcpNativeJdbcExtractor"
		lazy-init="true" />

	<bean id="lobHandler" class="org.springframework.jdbc.support.lob.OracleLobHandler"
		lazy-init="true">
		<property name="nativeJdbcExtractor">
			<ref bean="nativeJdbcExtractor" />
		</property>
	</bean>

	<!-- com.skyunoe.spring 패키지의 하위 bean 자동 등록 -->
	<context:component-scan base-package="co.kr.kydbm" />

	<mvc:interceptors>
		<mvc:interceptor>
			<!-- json-->
			<mvc:mapping path="/DATACRUD.json" />
			<mvc:mapping path="/M5Hash.json" />
			<mvc:mapping path="/GetJs.json" />
			<mvc:mapping path="/GetCode.json" />
			<mvc:mapping path="/GetHtml.json" />
			<mvc:mapping path="/sendIndvEmail.json" />
			<mvc:mapping path="/getUserInfo.json" />
			<!-- mon -->
			<mvc:mapping path="/upload.mon" />
			<mvc:mapping path="/fileupload.mon" />
			<mvc:mapping path="/filedownload.mon" />
			<mvc:mapping path="/exceldown.mon" />
			<mvc:mapping path="/doUploadDataFile.mon" />
			<mvc:mapping path="/main.mon"/>
			<bean class="co.kr.kydbm.core.interceptor.LoginCheckInterceptor" />
		</mvc:interceptor>
	</mvc:interceptors>
	
	<bean id="exceptionResolver" class="co.kr.kydbm.core.exception.ExceptionResolver">
	</bean>
	
	<!-- handler mapping -->
	<bean id="handlerMapping"
		class="org.springframework.web.servlet.mvc.annotation.DefaultAnnotationHandlerMapping" />

	<!-- view resolver -->
	<bean
		class="org.springframework.web.servlet.view.ContentNegotiatingViewResolver">
		<property name="mediaTypes">
			<map>
				<entry key="atom" value="application/atom+xml" />
				<entry key="html" value="text/html" />
 				<!--  <entry key="mon" value="text/html" /> -->
				<entry key="json" value="application/json" />
			</map>
		</property>
		<property name="viewResolvers">
			<list>
				<bean class="org.springframework.web.servlet.view.BeanNameViewResolver" >
				</bean>
				<bean class="org.springframework.web.servlet.view.InternalResourceViewResolver">
					<property name="viewClass" value="org.springframework.web.servlet.view.JstlView" />
					<property name="prefix" value="/ui/" />
					<property name="suffix" value=".jsp" />
				</bean>
			</list>
		</property>
		<property name="defaultViews">
			<list>
				<bean id="jsonView" 
					class="co.kr.kydbm.core.utils.MappingJacksonJsonViewEx">
<!-- 					class="org.springframework.web.servlet.view.json.MappingJacksonJsonView"> -->
<!-- 					<bean class="co.kr.kydbm.core.utils.MappingJacksonJsonViewEx"> -->
					<property name="prefixJson" value="false" /><!-- 헤더에{}&& 가 
						붙는현상..false로 하면 안보임 -->
				</bean>
			</list>
		</property>
	</bean>
	
	<!-- Dao Bean 설정 -->
	<bean id="MonArchDao" class="co.kr.kydbm.core.dao.MonArchDaoImpl">
<!-- 		<property name="dataSource" ref="dataSource" /> -->
		<property name="lobHandler" ref="lobHandler" />
	</bean>
	<bean id="MonArchExtDao" class="co.kr.kydbm.core.dao.DataSourceSupport">
		<property name="dataSource" ref="dataSource" />
		<!--<property name="monOraDataSource" ref="monOraDataSource" /> -->
	</bean>
	<bean id="DataUploadDao" class="co.kr.kydbm.core.dao.DataUploadDaoImpl">
		<property name="dataSource" ref="dataSource" />
	</bean>

	<!-- <bean id="LegacyIfDao" class="co.kr.kydbm.lghausys.scheduler.Dao.LegacyIfDaoImpl"> 
