	<!-- 개별다이렉트 메일 발송 Job -->
	<bean id="cronSendDirectMailJob" class="org.springframework.scheduling.quartz.JobDetailBean">
		<property name="jobClass" value="co.kr.kydbm.scheduler.job.SendDirectMailJob" />
	</bean>
	
	<!-- 1. 스케쥴 대상이 되는 클래스 정의 End -->
	
	
	<!-- 2. 스케쥴 시간 설정 Start -->
